{
  "name": "dsh-proactive-message",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Let the assistant initiate messages instead of only waiting to be asked.",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check lib/index.mjs && node --check client.js && node test-selfcheck.mjs && node test-client.mjs",
    "test": "node test-selfcheck.mjs && node test-client.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "proactive",
    "im"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
