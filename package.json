{
  "name": "dsh-whale-memory",
  "version": "0.4.0",
  "type": "module",
  "private": false,
  "description": "Proactive memory for DeepSeek Harness: emotion-aware recall, real BGE vectors, SQLite storage, and periodic associative rumination. Zero JS dependencies.",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "ruminate.js",
    "embed_server.py",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check lib/index.mjs && node --check client.js && node test-selfcheck.mjs && node test-routes.mjs && node test-client.mjs",
    "test": "node test-selfcheck.mjs && node test-routes.mjs && node test-client.mjs",
    "ruminate": "node ruminate.js",
    "check:all": "node scripts/check-all.mjs",
    "sync-shared": "node scripts/sync-shared.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "context",
    "token-optimization",
    "embeddings",
    "sqlite",
    "proactive-memory"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljm-233/dsh-whale-memory.git"
  },
  "homepage": "https://github.com/ljm-233/dsh-whale-memory#readme",
  "bugs": {
    "url": "https://github.com/ljm-233/dsh-whale-memory/issues"
  },
  "author": "ljm-233",
  "engines": {
    "node": ">=22.5"
  }
}
