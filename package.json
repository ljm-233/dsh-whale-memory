{
  "name": "dsh-whale-memory",
  "version": "0.3.0",
  "type": "module",
  "private": false,
  "description": "Proactive memory for DeepSeek Harness: emotion-aware recall, real BGE vectors, SQLite storage, and periodic associative rumination. Zero JS dependencies.",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "ruminate.js",
    "embed_server.py",
    "README.md"
  ],
  "scripts": {
    "check": "node --check lib/index.mjs && node test-selfcheck.mjs",
    "test": "node test-selfcheck.mjs",
    "ruminate": "node ruminate.js"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "context",
    "token-optimization",
    "embeddings",
    "sqlite",
    "proactive-memory"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljm-233/dsh-whale-memory.git"
  },
